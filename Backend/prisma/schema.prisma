// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AvailabilityType {
  WEEKLY
  FLEXIBLE
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum QuestionType {
  TEXT
  SELECT
  NUMBER
  BOOLEAN
}

/// Represents user roles within the system (e.g., ADMIN, PATIENT, DOCTOR)
model Role {
  id          Int            @id @default(autoincrement())
  roleName    String         @unique
  description String?
  identities  AuthIdentity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Core authentication table storing credentials and account status
model AuthIdentity {
  id           Int       @id @default(autoincrement())
  roleId       Int
  email        String    @unique @db.VarChar(255)
  passwordHash String
  isVerified   Boolean   @default(false)
  isActive     Boolean   @default(true)
  lastLogin    DateTime?

  role        Role              @relation(fields: [roleId], references: [id], onDelete: Restrict)
  userProfile UserProfile?
  otps        OtpVerification[]

  // Phase 2 Relations
  providerProfile   ProviderProfile?
  appointments      Appointment[]
  rescheduleChanges RescheduleHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stores OTP codes for various verification purposes like signup or password resets
model OtpVerification {
  id             Int        @id @default(autoincrement())
  authIdentityId Int
  otpCode        String     @db.VarChar(10)
  purpose        OtpPurpose
  expiresAt      DateTime
  isUsed         Boolean    @default(false)

  authIdentity AuthIdentity @relation(fields: [authIdentityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Stores personal details for a user, linked 1:1 with their auth identity
model UserProfile {
  id             Int       @id @default(autoincrement())
  authIdentityId Int       @unique
  fullName       String    @db.VarChar(150)
  phone          String?   @unique
  gender         Gender?
  dateOfBirth    DateTime? @db.Date
  profilePhoto   String?

  authIdentity AuthIdentity @relation(fields: [authIdentityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  slug        String    @unique
  services    Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id                      Int     @id @default(autoincrement())
  categoryId              Int
  name                    String
  description             String?
  duration                Int     @default(30)
  price                   Decimal @db.Decimal(10, 2)
  bufferTime              Int     @default(0)
  isPublished             Boolean @default(false)
  
  // Phase 3 Additions (Admin Configs)
  location                String?
  introMessage            String?
  confirmMessage          String?
  manualConfirmation      Boolean @default(false)
  manageCapacity          Boolean @default(false)
  capacityLimit           Int     @default(1)
  cancellationCutoffHours Int     @default(0)

  category         ServiceCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  providerMappings ProviderServiceMapping[]
  questions        BookingQuestion[]
  appointments     Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderProfile {
  id             Int     @id @default(autoincrement())
  authIdentityId Int     @unique
  bio            String?
  rating         Float   @default(0.0)
  isActive       Boolean @default(true)

  authIdentity    AuthIdentity             @relation(fields: [authIdentityId], references: [id], onDelete: Cascade)
  serviceMappings ProviderServiceMapping[]
  plans           AvailabilityPlan[]
  appointments    Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProviderServiceMapping {
  id         Int @id @default(autoincrement())
  providerId Int
  serviceId  Int

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([providerId, serviceId])
}

model AvailabilityPlan {
  id         Int              @id @default(autoincrement())
  providerId Int
  type       AvailabilityType @default(WEEKLY)
  isActive   Boolean          @default(true)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  slots    ScheduleSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleSlot {
  id           Int       @id @default(autoincrement())
  planId       Int
  dayOfWeek    Int? // 0-6 (Weekly)
  specificDate DateTime? // (Flexible)
  startTime    String // HH:mm
  endTime      String // HH:mm
  capacity     Int       @default(1)
  isBlocked    Boolean   @default(false)

  plan         AvailabilityPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Appointment {
  id                Int               @id @default(autoincrement())
  customerId        Int
  providerId        Int
  serviceId         Int
  slotId            Int
  startTime         DateTime
  endTime           DateTime
  status            AppointmentStatus @default(PENDING)
  totalPrice        Decimal           @db.Decimal(10, 2)
  rescheduledFromId Int?              @unique

  customer        AuthIdentity      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider        ProviderProfile   @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  slot            ScheduleSlot      @relation(fields: [slotId], references: [id], onDelete: Restrict)
  rescheduledFrom Appointment?      @relation("RescheduleLink", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?      @relation("RescheduleLink")
  responses       QuestionResponse[]
  payment         Payment?
  history         RescheduleHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RescheduleHistory {
  id            Int      @id @default(autoincrement())
  appointmentId Int
  oldStartTime  DateTime
  newStartTime  DateTime
  changedById   Int
  reason        String?

  appointment Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy   AuthIdentity @relation(fields: [changedById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

model BookingQuestion {
  id         Int          @id @default(autoincrement())
  serviceId  Int
  label      String
  type       QuestionType @default(TEXT)
  isRequired Boolean      @default(true)

  service   Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionResponse {
  id            Int    @id @default(autoincrement())
  appointmentId Int
  questionId    Int
  answer        String

  appointment Appointment     @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  question    BookingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id            Int           @id @default(autoincrement())
  appointmentId Int           @unique
  amount        Decimal       @db.Decimal(10, 2)
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  method        String?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
