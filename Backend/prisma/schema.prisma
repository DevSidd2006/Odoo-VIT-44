// Hackathon Optimized Schema - Simplified & High-Performance
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  CUSTOMER
  PROVIDER
}

enum OtpPurpose {
  SIGNUP
  PASSWORD_RESET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ScheduleType {
  WEEKLY
  FLEXIBLE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ==========================================
// CORE MODULES
// ==========================================

/// Merged User, Profile, and Provider Table
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         UserRole @default(CUSTOMER)

  // Profile Fields
  fullName     String
  phone        String? @unique
  gender       Gender?
  bio          String? @db.Text
  profilePhoto String?

  // Status
  isVerified Boolean @default(false)
  isActive   Boolean @default(true)

  // Relations
  otps     OtpVerification[]
  services Service[] // Services offered by this user (if Provider)
  bookings Booking[] // Bookings made by this user (if Customer)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpVerification {
  id        Int        @id @default(autoincrement())
  userId    Int
  code      String     @db.VarChar(10)
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  slug     String    @unique
  services Service[]
}

model Service {
  id          Int     @id @default(autoincrement())
  categoryId  Int
  providerId  Int
  name        String
  description String? @db.Text
  duration    Int     @default(30)
  price       Decimal @db.Decimal(10, 2)
  location    String? // Meeting venue / clinic / office
  isPublished Boolean @default(false)

  category ServiceCategory @relation(fields: [categoryId], references: [id])
  provider User            @relation(fields: [providerId], references: [id])

  slots     ScheduleSlot[]
  bookings  Booking[]
  questions BookingQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([providerId, name])
}

model ScheduleSlot {
  id           Int          @id @default(autoincrement())
  serviceId    Int
  type         ScheduleType @default(WEEKLY)
  dayOfWeek    Int? // 0-6
  specificDate DateTime?
  startTime    String // HH:mm
  endTime      String // HH:mm
  capacity     Int          @default(1)
  bookedCount  Int          @default(0)
  isBlocked    Boolean      @default(false) // Manual blocking for holidays/maintenance

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  createdAt DateTime @default(now())
}

model Booking {
  id         Int           @id @default(autoincrement())
  serviceId  Int
  customerId Int
  slotId     Int
  status     BookingStatus @default(PENDING)
  startTime  DateTime

  service  Service      @relation(fields: [serviceId], references: [id])
  customer User         @relation(fields: [customerId], references: [id])
  slot     ScheduleSlot @relation(fields: [slotId], references: [id])

  answers BookingAnswer[]
  payment Payment?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookingQuestion {
  id         Int     @id @default(autoincrement())
  serviceId  Int
  label      String
  isRequired Boolean @default(true)

  service Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  answers BookingAnswer[]
}

model BookingAnswer {
  id         Int    @id @default(autoincrement())
  bookingId  Int
  questionId Int
  answer     String @db.Text

  booking  Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  question BookingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model Payment {
  id            Int           @id @default(autoincrement())
  bookingId     Int           @unique
  amount        Decimal       @db.Decimal(10, 2)
  currency      String        @default("INR")
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
